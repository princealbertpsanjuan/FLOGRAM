{
  "expo": {
    "name": "FLOGRAM",
    "slug": "flogram",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flogram",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flogram.app"
    },
    "android": {
      "package": "com.flogram.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "FLOGRAM Admin",
      "shortName": "FLOGRAM Admin",
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "FLOGRAM needs access to your photos to upload bouquet images and payment or delivery proof.",
          "cameraPermission": "FLOGRAM needs camera access to take bouquet photos and delivery or payment proof."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FLOGRAM uses your location to share live delivery tracking while you are delivering an order."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dd2ec8bd-b1c0-40ab-aeda-9653aa9b294d"
      }
    },
    "owner": "flogram"
  }
}
