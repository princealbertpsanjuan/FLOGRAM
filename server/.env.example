# =========================================================
# FLOGRAM server environment variables
# Copy to .env for local development. On Render, add these
# under the web service → Environment.
# =========================================================

# --- Required ---------------------------------------------
# MongoDB Atlas connection string (mongodb+srv://...).
# A "mongodb://localhost..." value only works on your own PC.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/flogram?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
NODE_ENV=production

# Public address of this API (no trailing slash).
# Used for the PayMongo "payment finished" pages.
PUBLIC_BASE_URL=https://flogram-api.onrender.com

# --- File storage (Cloudinary) -----------------------------
# Copy "API environment variable" from the Cloudinary dashboard.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- AI image search (CLIP service) ------------------------
AI_SERVICE_URL=https://YOUR-HF-USERNAME-flogram-ai.hf.space

# --- Grok (xAI) -------------------------------------------
XAI_API_KEY=
# XAI_API_URL=https://api.x.ai/v1
# XAI_MODEL=
# XAI_IMAGE_MODEL=

# --- PayMongo ---------------------------------------------
PAYMONGO_SECRET_KEY=sk_test_xxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxx
# Optional overrides (defaults to PUBLIC_BASE_URL/payment/...)
# PAYMONGO_SUCCESS_URL=
# PAYMONGO_CANCEL_URL=
# PAYMONGO_PAYMENT_METHODS=card,gcash,qrph

# --- Routing (OpenRouteService) ----------------------------
OPENROUTESERVICE_API_KEY=

# --- Password reset email (Gmail app password) -------------
EMAIL_USER=
EMAIL_PASSWORD=

# --- Only for "npm run create-admin" ------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
