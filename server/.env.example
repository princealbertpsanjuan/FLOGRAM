# =========================================================
# FLOGRAM server environment variables
# Copy to .env for local development. On Render, add these
# under the web service → Environment.
# =========================================================

# --- Required ---------------------------------------------
# MongoDB Atlas connection string (mongodb+srv://...).
# A "mongodb://localhost..." value only works on your own PC.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/flogram?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Optional: separate secret for signed verification-document links
# (defaults to JWT_SECRET).
# UPLOAD_SIGNING_SECRET=
NODE_ENV=production

# Public address of this API (no trailing slash).
# Used for the PayMongo "payment finished" pages.
PUBLIC_BASE_URL=https://flogram-api.onrender.com

# --- File storage (Cloudinary) -----------------------------
# Copy "API environment variable" from the Cloudinary dashboard.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- AI image search (CLIP service) ------------------------
AI_SERVICE_URL=https://YOUR-HF-USERNAME-flogram-ai.hf.space

# --- Grok (xAI) -------------------------------------------
XAI_API_KEY=
# XAI_API_URL=https://api.x.ai/v1
# XAI_MODEL=
# XAI_IMAGE_MODEL=

# --- PayMongo ---------------------------------------------
PAYMONGO_SECRET_KEY=sk_test_xxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxx
# Optional overrides (defaults to PUBLIC_BASE_URL/payment/...)
# PAYMONGO_SUCCESS_URL=
# PAYMONGO_CANCEL_URL=
# PAYMONGO_PAYMENT_METHODS=card,gcash,qrph

# --- Routing (OpenRouteService) ----------------------------
OPENROUTESERVICE_API_KEY=

# --- Password reset email ---------------------------------
# Render's free plan blocks SMTP, so production uses Brevo's
# HTTPS API (see DEPLOYMENT.md, "Password reset email").
# EMAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM=
# Fallback when BREVO_API_KEY is empty (local development):
# Gmail address + Gmail app password.
EMAIL_USER=
EMAIL_PASSWORD=

# --- Only for "npm run create-admin" ------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Turn PayMongo off for everyone (e.g. pilot while PayMongo is in
# test mode). Checkout then offers only cash. Default: true
# ONLINE_PAYMENTS_ENABLED=false

# --- Optional tuning (defaults shown) -----------------------
# PORT=5000
# Browser origins allowed to call the API (Admin web portal).
# Empty = allow all. The mobile app is always allowed.
# CORS_ORIGINS=https://flogram-admin.onrender.com
# Cloudinary as three values instead of CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Minutes an unpaid PayMongo order waits before it is cancelled
# ONLINE_PAYMENT_WINDOW_MINUTES=30
# PAYMONGO_API_URL=https://api.paymongo.com
# PAYMONGO_TIMEOUT_MS=20000
# OPENROUTESERVICE_API_URL=https://api.openrouteservice.org
# Delivery route: cache length, timeout, and estimate fallback
# when OpenRouteService is down or out of quota (on/off)
# ROUTE_CACHE_MINUTES=10
# ROUTING_TIMEOUT_MS=10000
# ROUTING_FALLBACK=on
# Image search (Hugging Face Space) timeout
# AI_SERVICE_TIMEOUT_MS=60000
# Login / password-reset rate limiting (set "off" only for testing)
# RATE_LIMIT=on
# Separate database for "npm run verify:shifts"
# TEST_MONGODB_URI=
